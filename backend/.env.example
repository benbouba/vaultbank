# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────
# SQLite (default for local dev — no setup needed)
DATABASE_URL="file:./dev.db"

# PostgreSQL (uncomment for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/vaultbank"

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_BYTE_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption ───────────────────────────────────────────
# AES-256 key for encrypting BVN at rest (32 random bytes as hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX

# ─── BVN Verification (Prembly / Identitypass) ────────────
# Get keys at https://app.prembly.com
# Leave blank to use simulated verification in development
PREMBLY_API_KEY=
PREMBLY_APP_ID=
